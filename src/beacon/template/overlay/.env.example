# Beacon template environment
#
# The template runs on its own mock backend and needs no credentials or env file.
# Everything here is optional. To use it:
#   cp .env.example .env.local

# Environment: development | staging | production. Read from the app's address when unset.
# NEXT_PUBLIC_ENV=development

# Data: "mock" (default) serves the demo fleet from this app. "http" calls a real Beacon API and
# platform API that implement the same endpoints (see tests/unit/mock/mock-backend.test.js).
# NEXT_PUBLIC_API_ADAPTER=http
# NEXT_PUBLIC_BEACON_API_URL=https://beacon-api.example.org
# NEXT_PUBLIC_BEACON_API_PREFIX=/api/v1
# NEXT_PUBLIC_PLATFORM_API_URL=https://platform.example.org

# Signs the session cookie. The demo sign-in falls back to a fixed value; set your own
# before you add a real auth provider. At least 32 characters.
# NEXTAUTH_SECRET=

# Public URL of the app, for NextAuth. When it's unset the demo trusts the request's host
# (AUTH_TRUST_HOST), so it works on any address. Set it once you add a real auth provider.
# NEXTAUTH_URL=http://localhost:3000

# Road routing on the maintenance map (beacon.config.ts reads this for features.roadRouting).
# Off by default: routes use straight-line distances and no coordinates leave the browser.
# NEXT_PUBLIC_ENABLE_ROAD_ROUTING=true
# NEXT_PUBLIC_OSRM_BASE_URL=https://router.project-osrm.org

# Product analytics (PostHog). Nothing loads or is sent while the key is empty.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
