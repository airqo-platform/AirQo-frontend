{
  "$comment": "How scripts/export-template.mjs turns Beacon into the domain-neutral template. See template/README.md.",
  "package": {
    "name": "beacon-template",
    "version": "1.0.0",
    "removeDependencies": [
      "@prisma/client",
      "pg",
      "@react-three/drei",
      "@react-three/fiber",
      "three",
      "xterm",
      "xterm-addon-fit",
      "react-icons",
      "jose",
      "jwt-decode",
      "@svgr/webpack",
      "zustand"
    ],
    "removeDevDependencies": [
      "prisma"
    ],
    "removeTestGlobs": [
      "tests/unit/airqo/*.test.js"
    ]
  },
  "exclude": [
    "template/**",
    "scripts/export-template.mjs",
    "app/api/analyze-device/**",
    "app/api/auth/login/**",
    "app/api/firmware/**",
    "app/api/slack/**",
    "app/api/valid-device-locations/**",
    "app/dashboard/analytics/airqlouddata.json",
    "app/dashboard/analytics/devicedata.json",
    "app/dashboard/analytics/reproduce_issue.js",
    "app/dashboard/category/**",
    "app/dashboard/collocation/**",
    "app/dashboard/devices/[id]/remote-terminal-tab.tsx",
    "app/dashboard/firmware/**",
    "app/dashboard/stock/**",
    "app/dashboard/users/**",
    "app/favicon.ico",
    "app/register/**",
    "app/routes/**",
    "pages/**",
    "components/auth/auth-visual-hero.tsx",
    "components/auth/platform-login.tsx",
    "components/auth/selected-email-card.tsx",
    "components/auth/social-auth-section.tsx",
    "components/dashboard/app-dropdown.tsx",
    "components/integration/oauth-handoff.tsx",
    "components/iot/**",
    "hooks/iot/**",
    "lib/api.js",
    "lib/oauth-session.ts",
    "lib/platform-auth.ts",
    "services/category.service.ts",
    "services/firmware.service.ts",
    "services/inlab.service.ts",
    "services/iot/**",
    "services/stock.service.ts",
    "store/**",
    "types/category.types.ts",
    "types/firmware.types.ts",
    "types/inlab.types.ts",
    "types/iot/**",
    "types/stock.types.ts",
    "public/favicon.ico",
    "public/hdri/**",
    "public/icons/airqo_logo.svg",
    "public/icons/favicon*",
    "public/icons/gen6_assembly.glb",
    "public/images/AQR.jpeg",
    "cohortbyid.json",
    "docker-compose.yml",
    "docs/POSTHOG_ANALYTICS.md",
    "network-status-api-docs.md",
    "PERMISSIONS_GUIDE_FOR_FRONTEND.md",
    "response.json",
    ".gitkeep",
    "tests/configuration/**",
    "tests/docker/**",
    "tests/e2e/**",
    "tests/performance/**",
    "tests/security/**",
    "tests/unit/airqo/**",
    "tests/unit/components/**",
    "tests/unit/services/**",
    "tests/unit/session-manager.test.js"
  ],
  "neutrality": {
    "$comment": "After export, any line mentioning AirQo fails the export unless it matches one of these.",
    "skip": [
      "package-lock.json",
      "tests/**"
    ],
    "allow": [
      "@airqo/icons-react",
      "^\\s*airqo: \"AirQo\",$",
      "^\\s*airqo: \"bg-blue-100 text-blue-800 border-blue-200\",$"
    ]
  }
}
